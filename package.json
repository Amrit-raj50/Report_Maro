{
  "name": "sih2026-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Societal Innovation Portal - SIH 2026. Frontend + shared types built on top of the existing backend/ (Express + MongoDB, see PRs #4-#9).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @sih/shared-types build && pnpm --filter web dev",
    "build": "pnpm --filter @sih/shared-types build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "check:contract": "node scripts/check-contract.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
